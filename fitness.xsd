<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="fitnessClub">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="membres">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="membre" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="nom" type="xs:string"/>
                                        <xs:element name="age" type="xs:positiveInteger"/>
                                        <xs:element name="abonnement" type="xs:string"/>
                                        <xs:element name="actif" type="xs:boolean"/>
                                    </xs:sequence>
                                    <xs:attribute name="id" type="xs:positiveInteger" use="required"/>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
